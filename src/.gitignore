# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
/config/model-providers.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# runtime temp logs
tmp-*.log
tmp-*.err
tmp-*.out
/.codex-*.out
/.codex-*.err
/.dev-server.log
/.dev-server.pid

# database copies / test databases (local data — must NOT be committed)
/dev.db
prisma/dev.db
prisma/*.db
test_download.db
prisma/dev.db.bak-*
